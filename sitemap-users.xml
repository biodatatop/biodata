import { getApiBase } from "./functions/_shared/config.js";

if (url.pathname === "/sitemap-users.xml") {

  const apiBase = await getApiBase(context);
  const response = await fetch(`${apiBase}/sitemap-users.xml`);

  return new Response(
    await response.text(),
    {
      status: response.status,
      headers: {
        "Content-Type": response.headers.get("Content-Type") || "text/plain"
      }
    }
  );

}
